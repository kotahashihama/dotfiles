.DS_Store
Brewfile.old
.qodo

# 非公開層。private_dotfiles.zip で持ち回す
/private/

# 秘匿値の実体（雛形の scripts/secrets.env.example のみ追跡する）
secrets.env
*.env
!scripts/secrets.env.example

# リストア時の退避先
/dotfiles-salvaged-*

# フックの検査モジュールを import したときに出る
__pycache__/

# cf CLI が実行したディレクトリに置くキャッシュ（アカウントの ID と名前を持つ）
/.cloudflare/
