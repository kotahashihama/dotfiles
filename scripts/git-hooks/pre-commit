#!/bin/sh
#
# 公開側 (git 追跡対象) に、公開したくない文字列が混ざっていないかを検査する。
#
# 検査パターンは private/.claude/deny-patterns.txt に置く。パターン自体が
# 社内固有名であり公開できないため、公開側には持たない。
#
set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
PATTERNS="$REPO_ROOT/private/.claude/deny-patterns.txt"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

# 1) 認証情報らしき文字列（パターンは公開してよいので、ここに直接書く）
#
# 値の形で書く。「変数名」で書くと、このファイル自身やパターンを説明した
# ドキュメントに一致してしまう。
creds='sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{30}|sk-proj-[A-Za-z0-9_-]{30}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{30}|AKIA[0-9A-Z]{16}|xox[bpsa]-[0-9]{10}|_authToken[[:space:]]*=[[:space:]]*[A-Za-z0-9]|BEGIN [A-Z ]*PRIVATE KEY-----'
# 一般形も見る。形式の決まったトークンだけだと、DB の接続情報のような
# ありふれた形が素通りする。値の形を要求して、変数名だけの行や
# 雛形のプレースホルダには当てない。
generic='(PASSWORD|PASSWD|SECRET|API_?KEY|ACCESS_KEY|CLIENT_SECRET|AUTH_TOKEN)[A-Z_]*[[:space:]]*[=:][[:space:]]*"?[A-Za-z0-9!@#$%^&*_.+-]{8,}'
dburl='[a-z][a-z0-9+.-]*://[^[:space:]/:@]+:[^[:space:]/@]{4,}@'
# 雛形や例に書く値と、変数の参照。ここに当たる行は除く
holder='(xxx|XXX|your[-_]|dummy|sample|example|changeme|CHANGEME|REDACTED|placeholder|\*\*\*|<[a-zA-Z_ -]+>|=[[:space:]]*"?\$\{?[A-Za-z_])'

for f in $staged; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qaE "$creds"; then
    echo "✗ 認証情報らしき文字列: $f" >&2
    fail=1
  fi
done

# 1-b) 一般形の認証情報
for f in $staged; do
  [ -f "$f" ] || continue
  hit=$(git show ":$f" 2>/dev/null | grep -aE "$generic" | grep -avE "$holder" | head -1)
  if [ -z "$hit" ]; then
    hit=$(git show ":$f" 2>/dev/null | grep -aE "$dburl" | grep -avE "$holder" | head -1)
  fi
  if [ -n "$hit" ]; then
    echo "✗ 認証情報らしき値: $f" >&2
    fail=1
  fi
done

# 2) 非公開にしたい固有名
# ファイルごとに 1 行だけ報告する。パターンごとに報告すると、1 つの
# ファイルが複数パターンに一致したとき同じファイルが何度も並ぶ。
if [ -f "$PATTERNS" ]; then
  joined=$(grep -vE '^[[:space:]]*(#|$)' "$PATTERNS" | paste -sd'|' -)
  if [ -n "$joined" ]; then
    for f in $staged; do
      [ -f "$f" ] || continue
      hits=$(git show ":$f" 2>/dev/null | grep -oaiE "$joined" | sort -u | tr '\n' ' ')
      if [ -n "$hits" ]; then
        echo "✗ 非公開の固有名 ($hits): $f" >&2
        fail=1
      fi
    done
  fi
else
  echo "⚠️  $PATTERNS がありません。固有名の検査を飛ばします" >&2
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

このリポジトリは公開されています。上記を private/ へ移すか、伏せてから再度コミットしてください。
判断表: docs/placement.md ／ 点検手順: /audit-secrets

どうしても通す場合は git commit --no-verify（本当に公開してよいか確認してから）
MSG
  exit 1
fi

exit 0
