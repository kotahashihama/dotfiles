#!/bin/sh
#
# 公開層 (git 追跡対象) に、公開したくない文字列が混ざっていないかを検査する。
#
# 検査パターンは private/.claude/deny-patterns.txt に置く。パターン自体が
# 社内固有名であり公開できないため、公開層には持たない。
#
set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
PATTERNS="$REPO_ROOT/private/.claude/deny-patterns.txt"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

# 1) 認証情報らしき文字列（パターンは公開してよいので、ここに直接書く）
#
# 値の形で書く。「変数名」で書くと、このファイル自身やパターンを説明した
# ドキュメントに一致してしまう。
creds='sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{30}|sk-proj-[A-Za-z0-9_-]{30}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{30}|AKIA[0-9A-Z]{16}|xox[bpsa]-[0-9]{10}|_authToken[[:space:]]*=[[:space:]]*[A-Za-z0-9]|BEGIN [A-Z ]*PRIVATE KEY-----'
for f in $staged; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | grep -qaE "$creds"; then
    echo "✗ 認証情報らしき文字列: $f" >&2
    fail=1
  fi
done

# 2) 非公開にしたい固有名
if [ -f "$PATTERNS" ]; then
  while IFS= read -r pat; do
    case "$pat" in ''|'#'*) continue ;; esac
    for f in $staged; do
      [ -f "$f" ] || continue
      if git show ":$f" 2>/dev/null | grep -qaiE "$pat"; then
        echo "✗ 非公開の固有名 ($pat): $f" >&2
        fail=1
      fi
    done
  done < "$PATTERNS"
else
  echo "⚠️  $PATTERNS がありません。固有名の検査を飛ばします" >&2
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

このリポジトリは公開されています。上記を private/ 層へ移すか、伏せてから再度コミットしてください。
判断表: docs/layers.md ／ 点検手順: /audit-secrets

どうしても通す場合は git commit --no-verify（本当に公開してよいか確認してから）
MSG
  exit 1
fi

exit 0
