#!/bin/sh
#
# SwitchBot の CLI を、with-secrets が渡す SWITCHBOT_TOKEN・SWITCHBOT_CLIENT_SECRET で動かす
# MCP サーバーとして起動するときも、これを通す（ switchbot mcp serve ）
# switchbot config set-token はトークンを設定ファイルに残すので使わない
#
exec "$(dirname "$0")/with-secrets" sh -c \
  'SWITCHBOT_SECRET=$SWITCHBOT_CLIENT_SECRET exec "$HOME/.bun/bin/switchbot" "$@"' switchbot "$@"
