#!/usr/bin/env python3
#
# ~/.config/local-secrets/secrets.env の値を、渡したコマンドにだけ環境変数として渡す
#   with-secrets <コマンド> [引数...]
#
# ファイルは KEY=VALUE を1行に1つ書き、# で始まる行と空行は読み飛ばす。値は引用符を外さずそのまま渡す
# 1Password から読んでいたころは、呼ぶたびにサービスアカウントの上限（1日の読み取り回数）を減らし、
# 本人のアカウントでは毎回 Touch ID を求められたので、手元のファイルへ移した
# exec で子のコマンドに置き換わるので、MCP サーバーの標準入出力はそのまま子へ渡る
#
import os
import sys

if len(sys.argv) < 2:
    sys.exit("使い方: with-secrets <コマンド> [引数...]")

path = os.environ.get("LOCAL_SECRETS_FILE", os.path.expanduser("~/.config/local-secrets/secrets.env"))
try:
    lines = open(path, encoding="utf-8").read().splitlines()
except OSError:
    sys.exit(f"with-secrets: {path} がありません")

for line in lines:
    if not line.strip() or line.lstrip().startswith("#"):
        continue
    key, sep, value = line.partition("=")
    if sep:
        os.environ[key] = value

os.execvp(sys.argv[1], sys.argv[1:])
