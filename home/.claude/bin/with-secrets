#!/bin/sh
#
# 1Password の Environment 「dotfiles」の値を、渡したコマンドにだけ環境変数として渡す
#   with-secrets <コマンド> [引数...]
#
# トークンはキーチェーンから読み、シェル全体には export しない
# export すると op が全部サービスアカウントで動き、本人のアカウントで動くプラグイン（op plugin）が保管庫を読めなくなる
#
set -eu

ENVIRONMENT_ID=eog5jpgefqcis3twwdy7qb3cyq
KEYCHAIN_SERVICE=dotfiles-op-service-account

if ! token=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null); then
  echo "with-secrets: キーチェーンに $KEYCHAIN_SERVICE がありません" >&2
  exit 1
fi

# --no-masking: MCP サーバーの標準出力を書き換えないため
# env -u: 子のコマンドにトークンを渡さないため
OP_SERVICE_ACCOUNT_TOKEN=$token exec op run --no-masking --environment "$ENVIRONMENT_ID" -- \
  env -u OP_SERVICE_ACCOUNT_TOKEN "$@"
