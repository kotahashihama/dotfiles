#!/usr/bin/env python3
"""AWS の credential_process から呼ばれ、プロファイルのキーを 1Password の Environment から返す。

使い方（~/.aws/config）:
  [profile circus]
  credential_process = /Users/<ユーザー>/.claude/bin/aws-credentials circus

Environment の AWS_<プロファイル名を大文字に>_ACCESS_KEY_ID と _SECRET_ACCESS_KEY を読む。
AWS CLI・Terraform・SDK のどれから呼ばれても同じキーが渡り、~/.aws/credentials は要らない。
"""
import json
import os
import sys

if len(sys.argv) != 2:
    sys.exit("使い方: aws-credentials <プロファイル名>")
prefix = "AWS_" + sys.argv[1].upper().replace("-", "_")
key_id = os.environ.get(prefix + "_ACCESS_KEY_ID")

if not key_id and not os.environ.get("WITH_SECRETS_REEXEC"):
    os.environ["WITH_SECRETS_REEXEC"] = "1"
    wrapper = os.path.expanduser("~/.claude/bin/with-secrets")
    os.execv(wrapper, [wrapper, sys.executable, *sys.argv])
if not key_id:
    sys.exit(f"aws-credentials: {prefix}_ACCESS_KEY_ID が 1Password の Environment にありません")

json.dump({
    "Version": 1,
    "AccessKeyId": key_id,
    "SecretAccessKey": os.environ[prefix + "_SECRET_ACCESS_KEY"],
}, sys.stdout)
