{
  "cleanupPeriodDays": 365,
  "skillListingBudgetFraction": 0.02,
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "EDITOR": "cursor --wait",
    "VISUAL": "cursor --wait"
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude Code <noreply@anthropic.com>",
    "pr": "> [!NOTE]\n> この PR 説明は Claude Code を使って作成されています。"
  },
  "permissions": {
    "allow": [
      "mcp__backlog__get_*",
      "mcp__backlog__count_issues",
      "mcp__plugin_figma_figma__get_*",
      "mcp__plugin_figma_figma__list_*",
      "mcp__plugin_figma_figma__search_design_system",
      "mcp__plugin_figma_figma__whoami",
      "Bash(~/.claude/scripts/db-select.py:*)"
    ],
    "deny": [
      "mcp__backlog__add_project",
      "mcp__backlog__update_project",
      "mcp__backlog__delete_project"
    ]
  },
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tidy-global-assets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/surface-swallowed-failures.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/surface-deleted-comments.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-known-footguns.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/lint-github-body.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-pr-operations.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-recommended-option.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/relink-settings.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/report-dotfiles-state.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-pointless-stop.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-writing-in-files.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/suggest-learn-rules.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "codex@openai-codex": true,
    "skill-creator@claude-plugins-official": true,
    "agentkit-shopify@worldcoin-agentkit": true,
    "agy-skills@agy-skills": true,
    "claude-code-mermaid@claude-code-mermaid": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "worldcoin-agentkit": {
      "source": {
        "source": "github",
        "repo": "worldcoin/agentkit-shopify-demo"
      }
    },
    "agy-skills": {
      "source": {
        "source": "github",
        "repo": "wildriver/agy-skills"
      }
    },
    "claude-code-mermaid": {
      "source": {
        "source": "github",
        "repo": "gecm0/render-mermaid"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "Japanese",
  "spinnerTipsEnabled": false,
  "awaySummaryEnabled": true,
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": false,
  "showTurnDuration": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
