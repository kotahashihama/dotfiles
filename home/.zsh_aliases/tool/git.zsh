alias g='git'
alias gf='g fetch'
alias gpl='g pull'
alias gplmain='gf origin && gpl origin main:main'
alias gplmas='gf origin && gpl origin master:master'
alias gplrel='gf origin && gpl origin release:release'
alias gpldev='gf origin && gpl origin develop:develop'
alias gst='g status -sb'
alias gsh='g stash'
alias gshl='gsh list'
alias gsha='gsh apply'
alias gsha0='gsha stash@{0}'
alias gshd='gsh drop'
alias gsu='git submodule update --init --recursive'
alias ga='g add'
alias gaa='ga -A'
alias gc='g commit'
alias gcm='gc -m'
alias gacm='gaa && gcm'
alias gca='gc --amend'
alias gcam='gca -m'
alias gcan='gca --no-edit'
alias gcz='g cz'
alias gacz='gaa && gcz'
alias gfc='g commit --allow-empty -m "first commit"'
alias gps='g push -u'
alias gpsf='gps --force-with-lease'
alias gpsh='gps origin HEAD'
alias gpshn='gpsh --no-verify'
alias gpshf='gpsh --force-with-lease'
alias gpshfn='gpshf --no-verify'
alias gpsstg='git push -f origin HEAD:staging'
alias gdf='g diff'
alias gdfs='g diff --staged'
alias gbr='g branch'
alias gbrc='git rev-parse --abbrev-ref HEAD'
alias gbrm='gbr -m'
alias gbrp='gbr | fzf | pbcopy && echo クリップボードにコピーされました'
alias gco='g checkout'
alias gco-='gco -'
alias gcob='gco -b'
alias gcomain='gco main'
alias gcomas='gco master'
alias gcorel='gco release'
alias gcodev='gco develop'
alias gcp='g cherry-pick'
alias gcpc='gcp --continue'
alias gcpa='gcp --abort'
alias gl='g log'
alias glo='gl --oneline'
alias grl='g reflog'
alias gtm='gaa && gcm "temp" -n'
alias gtmps='gtm ; gps'
alias gr='g reset'
alias gr.='gr .'
alias grs='gr --soft'
alias grsh='grs HEAD\^'
alias grh='gr --hard'
alias grhh='grh HEAD\^'
alias grcof='gr. && gco -f'
alias grb='g rebase'
alias grbmain='gplmain && grb main'
alias grbmas='gplmas && grb master'
alias grbrel='gplrel && grb release'
alias grbdev='gpldev && grb develop'
alias grbi='grb -i'
alias grbc='grb --continue'
alias grba='grb --abort'
alias gm='g merge'
alias gmc='gm --continue'
alias gma='gm --abort'
alias grm='g remote'
alias grmv='grm -v'
alias grmao='grm add origin'
alias grmsu='grm set-url'
alias grmsuo='grmsu origin'
alias grmrn='grm rename'
alias gwr='git worktree add'
alias gwrf='git worktree remove'
alias gwls='git worktree list'

# GitHub CLI
alias grp='gh repo view -w'
alias gtsk='gh issue list -a kotahashihama'
alias gtskc='gh issue list -s closed'
alias gis='gh issue list -w'
alias gism='gh issue status'
alias gisc='gh issue view -w $(gbrc | sed -E "s/^.+#([0-9]+).+\$/\1/")'
alias gpr='gh pr list -w'
alias gprm='gh issue status'
alias gprc='gh pr view -w'
alias gprco='gh pr checkout'
alias gci='gh pr checks'
alias grd='gh pr ready'

# ghq
alias ghqg='ghq get'
