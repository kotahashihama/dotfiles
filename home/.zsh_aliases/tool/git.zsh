alias g='git'
alias gf='g fetch'
alias gpl='g pull'
# 手元の main などを、切り替えずにリモートへ追いつかせる。そのブランチにいるときは gpl を使う
alias gfplmain='gf origin main:main'
alias gfplmas='gf origin master:master'
alias gfplrel='gf origin release:release'
alias gfpldev='gf origin develop:develop'
alias gst='g status -sb'
alias gsh='g stash'
alias gshl='gsh list'
alias gsha='gsh apply'
alias gshd='gsh drop'
alias gsu='git submodule update --init --recursive'
alias ga='g add'
alias gaa='ga -A'
alias gc='g commit'
alias gcm='gc -m'
alias gacm='gaa && gcm'
alias gca='gc --amend'
alias gcam='gca -m'
alias gcan='gca --no-edit'
alias gcz='g cz'
alias gacz='gaa && gcz'
alias gfc='g commit --allow-empty -m "first commit"'
alias gps='g push'
alias gpsf='gps --force-with-lease'
alias gpsh='gps origin HEAD'
alias gpshn='gpsh --no-verify'
alias gpshf='gpsh --force-with-lease'
alias gpshfn='gpshf --no-verify'
alias gpsstg='g push --force-with-lease origin HEAD:staging'
alias gdf='g diff'
alias gdfs='g diff --staged'
alias gbr='g branch'
alias gbrc='git branch --show-current'
alias gbrm='gbr -m'
alias gbrp='gbr --format="%(refname:short)" | fzf | pbcopy && echo クリップボードにコピーされました'
# ブランチの切り替えは switch、ファイルの復元は restore（checkout から分かれた）
alias gsw='g switch'
alias gsw-='gsw -'
alias gswc='gsw -c'
alias gswmain='gsw main'
alias gswmas='gsw master'
alias gswrel='gsw release'
alias gswdev='gsw develop'
alias gcp='g cherry-pick'
alias gcpc='gcp --continue'
alias gcpa='gcp --abort'
alias gl='g log'
alias glo='gl --oneline'
alias grl='g reflog'
alias gtm='gaa && gcm "temp" -n'
alias gtmps='gtm ; gps'
alias gr='g reset'
alias grs='gr --soft'
alias grsh='grs HEAD\^'
alias grh='gr --hard'
alias grhh='grh HEAD\^'
alias grt='g restore'
alias grt.='grt .'
alias grts='grt --staged'
alias grts.='grts .'
alias grb='g rebase'
alias grbmain='gf origin && grb origin/main'
alias grbmas='gf origin && grb origin/master'
alias grbrel='gf origin && grb origin/release'
alias grbdev='gf origin && grb origin/develop'
alias grbi='grb -i'
alias grbc='grb --continue'
alias grba='grb --abort'
alias gm='g merge'
alias gmc='gm --continue'
alias gma='gm --abort'
alias grm='g remote'
alias grmv='grm -v'
alias grmao='grm add origin'
alias grmsu='grm set-url'
alias grmsuo='grmsu origin'
alias grmrn='grm rename'
alias gwr='git worktree add'
alias gwrf='git worktree remove'
alias gwls='git worktree list'

# GitHub CLI
alias grp='gh repo view -w'
alias gtsk='gh issue list -a @me'
alias gtskc='gh issue list -s closed'
alias gis='gh issue list -w'
alias gism='gh issue status'
alias gisc='gh issue view -w $(gbrc | sed -E "s/^.+#([0-9]+).+\$/\1/")'
alias gpr='gh pr list -w'
alias gprm='gh pr status'
alias gprc='gh pr view -w'
alias gprco='gh pr checkout'
alias gci='gh pr checks'
alias grd='gh pr ready'

# ghq
alias ghqg='ghq get'
