[ghq]
	root = ~/Documents/repositories
[user]
	name = Kota Hashihama
	email = kotahashihama@gmail.com
[push]
	default = current
	autoSetupRemote = true
	useForceIfIncludes = true
[pull]
	ff = only
	rebase = false
[init]
	defaultBranch = main
[core]
	autocrlf = false
	editor = vim
	pager = delta
	fsmonitor = true
	untrackedCache = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[difftool]
	prompt = false
[alias]
	dt = difftool --tool difftastic
	dtl = -c diff.external=difft log --ext-diff -p
[merge]
	conflictstyle = zdiff3
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rebase]
	autostash = true
	abbreviateCommands = true
	autosquash = true
	updateRefs = true
[fetch]
	prune = true
[rerere]
	enabled = true
	autoupdate = true
[diff]
	algorithm = histogram
	colorMoved = plain
[branch]
	sort = -committerdate
[column]
	ui = auto
[help]
	autocorrect = prompt
[commit]
	verbose = true
[include]
	path = ~/.config/git/maintenance
